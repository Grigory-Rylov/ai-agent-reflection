-
-func sanitizeFilename(name string) string {
-	if name == "" {
-		return ""
-	}
-	s := filepath.Base(name)
-	for _, r := range s {
-		if r < '!' || r > '~' {
-			s = "artifact_"
-			break
-		}
-	}
-	return s
-}
